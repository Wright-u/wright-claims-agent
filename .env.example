PORT=4000
NODE_ENV=development

#  LLM via Groq https://console.groq.com/keys
LLM_API_KEY=gsk_xxxx
LLM_MODEL=openai/gpt-oss-20b

CORE_MCP_URL=http://localhost:5000/mcp
CORE_API_KEY=shared-dev-token

AGENT_API_KEY=shared-dev-token


# CORE_MODE=mock
CORE_MODE=mcp
MOCK_FIXTURE_PATH=test/mock-core/fixtures/notes-tool.json

# Name of whichever tool reveals real source code, so it can be rationed
CODE_READ_TOOL_NAME=request_code

# Loop limits
MAX_ROUNDS=4
MAX_CODE_REQUESTS_PER_CLAIM=2

# Demo safety
LLM_CACHE_ENABLED=true
LLM_CACHE_DIR=.cache/llm
